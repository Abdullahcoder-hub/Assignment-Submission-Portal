PORT=5000
MONGODB_URI=YOUR_MONGODB_URI

JWT_SECRET=

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=Your Sender Email Address
BREVO_SENDER_NAME=Assignment Portal Admin

# Production: set this to the deployed frontend URL, without a trailing slash.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000/api

TIMEZONE=Asia/Karachi

GOOGLE_CLIENT_ID=your_google_client_id

# Super Admin accounts (add sequential SUPER_ADMIN_2_*, SUPER_ADMIN_3_* sets as needed)
SUPER_ADMIN_1_NAME=Super Admin
SUPER_ADMIN_1_EMAIL=admin@example.com
SUPER_ADMIN_1_PASSWORD=
